.phase1d-card {
  margin: 20px 0;
  padding: 22px;
  background: #ffffff;
  border: 1px solid #dfe7ef;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(20, 56, 86, .05);
}

.phase1d-card h3 {
  color: #173b59;
  font-size: 19px;
  margin: 0 0 12px;
}

.phase1d-card h4 {
  color: #254963;
  margin: 22px 0 12px;
}

.phase1d-card p {
  color: #647c91;
  line-height: 1.6;
}

.phase1d-dialog {
  position: fixed;
  width: min(640px, calc(100vw - 32px));
  max-height: min(85vh, 760px);
  padding: 0;
  border: 1px solid #dce6f0;
  border-radius: 16px;
  background: #fff;
  color: #233d54;
  box-shadow: 0 22px 70px #102b4650;
  overflow-y: auto;
}
.phase1d-dialog::backdrop { background: #10284088; }
.phase1d-dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 20px 24px;
  border-bottom: 1px solid #e6edf3;
  background: #f6fafe;
}
.phase1d-dialog-header h2 { margin: 0; font-size: 19px; color: #173b59; }
.phase1d-dialog-header p { margin: 5px 0 0; font-size: 12px; color: #71869a; }
.phase1d-dialog-close {
  padding: 9px 15px;
  border: 1px solid #d5e0ea;
  border-radius: 8px;
  background: white;
  color: #275579;
  cursor: pointer;
}
.phase1d-dialog .phase1d-card {
  margin: 0;
  padding: 24px;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}
.phase1d-dialog .phase1d-card form { display: grid; gap: 17px; margin-top: 20px; }
.phase1d-dialog .phase1d-card form label {
  display: grid;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
  color: #34546c;
}
.phase1d-dialog .phase1d-card select,
.phase1d-dialog .phase1d-card input,
.phase1d-dialog .phase1d-card textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 11px 13px;
  border: 1px solid #d4e0ed;
  border-radius: 8px;
  background: #fff;
  color: #263f55;
  font: inherit;
}
.phase1d-dialog .phase1d-card textarea { min-height: 90px; resize: vertical; }
.phase1d-dialog .phase1d-card form button {
  justify-self: end;
  padding: 11px 18px;
  border: 0;
  border-radius: 8px;
  background: #1769a8;
  color: white;
  font-weight: 700;
  cursor: pointer;
}
.phase1d-dialog .phase1d-card form button:disabled {
  background: #dce5ed;
  color: #7e91a1;
  cursor: not-allowed;
}
.phase1d-dialog .phase1d-card li { margin: 10px 0; line-height: 1.6; }
.phase1d-dialog .phase1d-card ul { padding-left: 20px; }
@media (max-width: 600px) {
  .phase1d-dialog-header { padding: 16px; }
  .phase1d-dialog .phase1d-card { padding: 16px; }
  .phase1d-dialog .phase1d-card form button { width: 100%; }
}
/* PHASE1D CENTER FIX */
.phase1d-dialog {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(640px, calc(100vw - 32px));
  max-width: none;
  max-height: min(85dvh, 760px);
  box-sizing: border-box;
  overscroll-behavior: contain;
}
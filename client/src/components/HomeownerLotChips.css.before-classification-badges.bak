.homeowner-lot-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}
.homeowner-lot-chips button {
  border: 1px solid currentColor;
  border-radius: 999px;
  padding: 8px 14px;
  color: inherit;
  background: transparent;
  font: inherit;
  cursor: pointer;
}
.homeowner-lot-chips button[aria-current="page"] {
  color: white;
  background: #2563eb;
  border-color: #2563eb;
}
.homeowner-lot-chips button:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 3px;
}

# Copy to .env.local and fill in. Never commit real values.
# Both values are PUBLIC (safe in the browser) - protection comes from Row Level Security.
# NEVER put the service_role / secret key in any VITE_ variable: Vite bundles VITE_ values into the site.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key